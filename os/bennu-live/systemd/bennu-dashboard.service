[Unit]
Description=Bennu Dashboard
After=network-online.target docker.service
Wants=network-online.target
Requires=docker.service

[Service]
Type=oneshot
WorkingDirectory=/opt/bennu
ExecStart=/usr/bin/docker compose -f /opt/bennu/infra/docker/docker-compose.prod.yml up -d
ExecStop=/usr/bin/docker compose -f /opt/bennu/infra/docker/docker-compose.prod.yml down
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
